    "ru": ("ru", "RU", "RU:ru"), "en": ("en-US", "US", "US:en"), "de": ("de", "DE", "DE:de"),
    "fr": ("fr", "FR", "FR:fr"), "uk": ("uk", "UA", "UA:uk"), "es": ("es-419", "US", "US:es-419"),
